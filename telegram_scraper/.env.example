# ── Telegram credentials ─────────────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org → My Applications
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Your phone number with country code (used for first-time login only)
TELEGRAM_PHONE=+16471234567

# The Telegram group to monitor
TELEGRAM_GROUP_URL=https://t.me/Amlaketoronto

# Local session file (stores auth so you don't log in every time)
TELEGRAM_SESSION_FILE=telegram_session

# ── Claude / Anthropic ────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Paths ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
DB_PATH=businesses.db

# ── Tuning ────────────────────────────────────────────────────────────────────
# Max messages to fetch per run
FETCH_LIMIT=200

# Seconds to wait between processing messages (avoids rate limits)
DELAY_SECONDS=2

# Informational only – actual scheduling is done via cron/GitHub Actions
UPDATE_INTERVAL_HOURS=1
