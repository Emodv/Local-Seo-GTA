# AtlasJobs AI — environment configuration. Copy to .env and fill in.
# Never commit real secrets. Secrets in the DB are envelope-encrypted at rest.

# ── Datastores ──
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlasjobs?schema=public"
REDIS_URL="redis://localhost:6379"

# ── App ──
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"
NODE_ENV=development

# ── Auth (Auth.js / NextAuth) ──
AUTH_SECRET=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
MAGIC_LINK_FROM_EMAIL=""

# ── Secret encryption (envelope) ──
KMS_KEY_ID=""              # cloud KMS key that wraps the data-encryption key
DATA_ENCRYPTION_KEY=""     # local dev only; use KMS in prod

# ── LLM ──
ANTHROPIC_API_KEY=""
LLM_DEFAULT_MODEL="claude-sonnet-5"

# ── Google integrations (Gmail drafts, Calendar) ──
# Uses the user's OAuth grant; these are the app credentials.
GOOGLE_GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.compose"
GOOGLE_CALENDAR_SCOPES="https://www.googleapis.com/auth/calendar.events"

# ── Job data sources (Tier A official APIs need no key; Tier B needs a license) ──
# Tier B (LinkedIn/Indeed/Google Jobs CONTENT) via a LICENSED aggregator only.
JOBS_AGGREGATOR_API_KEY=""   # leave blank to disable Tier B (no scraping fallback)
GREENHOUSE_BOARDS=""         # comma-separated board tokens to poll
LEVER_SITES=""               # comma-separated lever site slugs
ASHBY_ORGS=""                # comma-separated ashby org slugs

# ── Optional enrichment (recruiter/hiring-manager contacts) ──
APOLLO_API_KEY=""            # user-authorized; used only when enabled

# ── Object storage (rendered résumé/cover-letter PDFs) ──
S3_ENDPOINT=""
S3_BUCKET="atlasjobs-artifacts"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── Notifications ──
SLACK_WEBHOOK_URL=""
