{
  "name": "atlasjobs",
  "version": "0.1.0",
  "private": true,
  "description": "AtlasJobs AI — the autonomous executive job hunter (monorepo root).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prisma": "^5.19.0",
    "tsx": "^4.23.1",
    "turbo": "^2.1.0",
    "typescript": "^5.6.2"
  }
}
