X_API_KEY_SECRET=...                      # OAuth 1.0a consumer secret
X_ACCESS_TOKEN=...                        # User access token
X_ACCESS_TOKEN_SECRET=...                 # User access token secret

# ── Optional ──────────────────────────────────────────────────────────────────
SESSION_SECRET=your-random-secret
NODE_ENV=production
