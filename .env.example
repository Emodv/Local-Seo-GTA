# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...        # Claude API for AI content generation
DATABASE_URL=postgresql://user:pass@host:5432/dbname  # Auto-set by Railway PostgreSQL

# ── SemRush (real keyword data + domain analysis) ─────────────────────────────
SEMRUSH_API_KEY=af187ac9...               # Adds real search volumes, competitor intel

# ── Google (business validation + Maps listing check) ────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSy...             # Google Places API for NAP validation

# ── ScrapeGraphAI (AI-powered scraping for JS-heavy sites) ───────────────────
SCRAPEGRAPHAI_API_KEY=sgai-...            # Smarter content extraction
